# Database (MySQL via Prisma)
DATABASE_URL="mysql://root@127.0.0.1:3306/dreamcode_botwa"

# Port backend — frontend me-rewrite /api/* ke port ini (lihat next.config.ts)
PORT=3001

# CORS — origin frontend Next.js
CORS_ORIGIN="http://localhost:3000"

# Opsional — punya nilai default di kode
JWT_SECRET="dreamcode-botwa-secret-key"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY=""